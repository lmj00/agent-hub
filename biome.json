{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "apps/**/*.mjs",
      "apps/**/*.css",
      "apps/**/*.json",
      "packages/**/*.ts",
      "packages/**/*.json",
      "scripts/**/*.mjs",
      "*.json",
      "!apps/server/migrations/**",
      "!apps/server/tests/fixtures/**",
      "!apps/server/skills/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "correctness": {
        "noConstAssign": "error",
        "noInvalidConstructorSuper": "error",
        "noUnreachable": "error",
        "noUnsafeFinally": "error",
        "useValidTypeof": "error"
      },
      "suspicious": {
        "noCompareNegZero": "error",
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateObjectKeys": "error",
        "noSparseArray": "error"
      },
      "preset": "none"
    }
  }
}
