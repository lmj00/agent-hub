{
  "name": "agent-hub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-hub/contracts build && pnpm --filter @agent-hub/server dev",
    "dev:web": "pnpm --filter @agent-hub/contracts build && pnpm --filter @agent-hub/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @agent-hub/server start",
    "task:run": "pnpm --filter @agent-hub/contracts build && pnpm --filter @agent-hub/server task:run",
    "backup": "pnpm --filter @agent-hub/contracts build && pnpm --filter @agent-hub/server backup",
    "auth:setup": "pnpm --filter @agent-hub/server auth:setup",
    "db:generate": "pnpm --filter @agent-hub/contracts build && pnpm --filter @agent-hub/server db:generate",
    "typecheck": "pnpm --filter @agent-hub/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @agent-hub/contracts build && pnpm -r test",
    "test:browser": "pnpm build && pnpm --filter @agent-hub/web test:browser",
    "monitor": "pnpm --filter @agent-hub/server monitor",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome ci . && pnpm check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "7.0.2"
  }
}
