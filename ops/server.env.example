# Install privately as /etc/agent-hub/server.env. This is systemd syntax, not a shell script.
PORT=3000
DATABASE_PATH=/var/lib/agent-hub/state/agent-hub.sqlite
AUTH_CONFIG=/etc/agent-hub/auth.json
EXECUTION_CONFIG=/etc/agent-hub/execution.json
# Enable only after preparing the optional read-only service observation config.
# SERVICE_CONFIG=/etc/agent-hub/services.json
# Enable only after preparing an operator-owned JSON webhook and private config.
# NOTIFICATION_CONFIG=/etc/agent-hub/notifications.json
