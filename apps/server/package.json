{
  "name": "@agent-hub/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "task:run": "tsx src/run-task-cli.ts",
    "backup": "tsx src/backup-cli.ts",
    "auth:setup": "tsx src/auth-setup-cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "monitor": "tsx src/monitor-cli.ts"
  },
  "dependencies": {
    "@agent-hub/contracts": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/session": "11.1.6",
    "@fastify/static": "10.1.8",
    "@openai/codex-sdk": "0.166.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
